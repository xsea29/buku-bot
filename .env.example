# Required
BOT_TOKEN=
# One numeric Telegram user ID, or several separated by commas.
ADMIN_TELEGRAM_ID=

# Database. Leave unset locally to use a file at data/buku.sqlite.
# In production use a Turso database:
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=

# Optional (defaults shown)
# PORT=             # set by the host; enables the /health endpoint
# TITLE_MIN_LENGTH=2
# TITLE_MAX_LENGTH=200
# EMAIL_MAX_LENGTH=254
# PENDING_LIST_LIMIT=30
